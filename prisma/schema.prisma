generator client {
  provider      = "prisma-client-js"
  // CloudLinux host is RHEL-based — ship the rhel-openssl-3.0.x engine so
  // the client generated on macOS/Linux also runs on the server.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  order Int        @default(0)
  items MenuItem[]
}

model MenuItem {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Float
  videoUrl    String
  posterUrl   String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
}
