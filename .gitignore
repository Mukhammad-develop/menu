# dependencies
/node_modules

# next.js
# .next build output IS committed: the cPanel server cannot run `next build`
# (CloudLinux thread limits), so the compiled app ships via git.
# The webpack cache is machine-specific and huge — always ignored.
/.next/cache/
/out/

# production
/build

# env
.env
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
.vercel

# uploaded videos (keep the directory, ignore its contents)
public/uploads/videos/*
!public/uploads/videos/.gitkeep
